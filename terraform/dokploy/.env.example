# Copy to .env on each laptop, then source it before Terraform commands:
#   set -a; source .env; set +a
# Retrieve this value from your password manager; never commit .env.
export TF_VAR_dokploy_api_key="replace-with-dokploy-api-key"
# Docker Hub token with "Public Repo Read-only" scope (Tikkit image pulls).
export TF_VAR_tikkit_registry_token="replace-with-docker-hub-read-only-token"
