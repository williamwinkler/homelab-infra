{
  "uid": "tikkit-rpc",
  "title": "Tikkit · RPC investigation",
  "description": "Investigate RPC action, operation and outcome with metrics, sampled traces and completion logs. DB context remains service/environment scoped.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": ["tikkit", "application"],
  "timezone": "browser",
  "refresh": "1m",
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "annotations": {"list": [{"name": "Tikkit deployments", "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": false, "iconColor": "rgba(0, 211, 255, 1)", "target": {"type": "tags", "tags": ["tikkit-deployment"], "matchAny": false, "limit": 100}}]},
  "links": [
    {"title": "Overview", "type": "link", "targetBlank": false, "url": "/d/tikkit-api?from=${__from}&to=${__to}&${environment:queryparam}"},
    {"title": "RPC investigation", "type": "link", "targetBlank": false, "url": "/d/tikkit-rpc?from=${__from}&to=${__to}&${environment:queryparam}&${action:queryparam}&${operation:queryparam}&${success:queryparam}"},
    {"title": "Organizations", "type": "link", "targetBlank": false, "url": "/d/tikkit-organizations?from=${__from}&to=${__to}&${environment:queryparam}&${action:queryparam}"},
    {"title": "Runtime", "type": "link", "targetBlank": false, "url": "/d/tikkit-runtime?from=${__from}&to=${__to}&${environment:queryparam}"},
    {"title": "Explore RPC traces", "type": "link", "targetBlank": true, "url": "/explore?schemaVersion=1&panes=%7B%22A%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22query%22%3A%22%7B%20resource.service.name%20%3D%20%5C%22$service%5C%22%20%26%26%20resource.deployment.environment%20%3D~%20%5C%22${environment:regex}%5C%22%20%26%26%20span.tikkit.rpc.action%20%3D~%20%5C%22${action:regex}%5C%22%20%26%26%20span.tikkit.rpc.operation%20%3D~%20%5C%22${operation:regex}%5C%22%20%26%26%20span.tikkit.rpc.success%20%3D~%20%5C%22${success:regex}%5C%22%20%7D%22%2C%22queryType%22%3A%22traceql%22%2C%22tableType%22%3A%22traces%22%2C%22limit%22%3A20%2C%22filters%22%3A%5B%5D%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"},
    {"title": "Explore RPC completion logs", "type": "link", "targetBlank": true, "url": "/explore?schemaVersion=1&panes=%7B%22A%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D%5C%22$service%5C%22%2Cdeployment_environment%3D~%5C%22${environment:regex}%5C%22%7D%20%7C%3D%20%5C%22rpc_completed%5C%22%20%7C%20json%20event%3D%5C%22message.event%5C%22%2C%20organization_id%3D%5C%22message.organization_id%5C%22%2C%20action%3D%5C%22message.action%5C%22%2C%20operation%3D%5C%22message.operation%5C%22%2C%20success%3D%5C%22message.success%5C%22%2C%20error_type%3D%5C%22message.error_type%5C%22%2C%20duration_ms%3D%5C%22message.duration_ms%5C%22%20%7C%20__error__%3D%5C%22%5C%22%20%7C%20event%3D%5C%22rpc_completed%5C%22%20%7C%20action%3D~%5C%22${action:regex}%5C%22%20%7C%20operation%3D~%5C%22${operation:regex}%5C%22%20%7C%20success%3D~%5C%22${success:regex}%5C%22%22%2C%22queryType%22%3A%22range%22%2C%22editorMode%22%3A%22code%22%2C%22maxLines%22%3A100%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"}
  ],
  "templating": {"list": [
    {"name": "service", "label": "Service", "type": "constant", "hide": 2, "query": "tikkit-api", "current": {"text": "tikkit-api", "value": "tikkit-api"}},
    {"name": "environment", "label": "Environment", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "definition": "label_values(tikkit_rpc_requests_total{service_name=\"$service\"},deployment_environment)", "query": {"query": "label_values(tikkit_rpc_requests_total{service_name=\"$service\"},deployment_environment)", "refId": "EnvironmentVariableQuery"}, "refresh": 2, "sort": 1, "multi": true, "includeAll": true, "allValue": ".*", "current": {"text": ["All"], "value": ["$__all"]}, "options": []},
    {"name": "action", "label": "RPC action", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "definition": "label_values(tikkit_rpc_requests_total{service_name=\"$service\",deployment_environment=~\"${environment:regex}\"},action)", "query": {"query": "label_values(tikkit_rpc_requests_total{service_name=\"$service\",deployment_environment=~\"${environment:regex}\"},action)", "refId": "ActionVariableQuery"}, "refresh": 2, "sort": 1, "multi": true, "includeAll": true, "allValue": ".*", "current": {"text": ["All"], "value": ["$__all"]}, "options": []},
    {"name": "operation", "label": "Operation", "type": "custom", "query": "run,validate", "multi": true, "includeAll": true, "allValue": ".*", "current": {"text": ["All"], "value": ["$__all"]}, "options": [{"text": "All", "value": "$__all", "selected": true}, {"text": "run", "value": "run", "selected": false}, {"text": "validate", "value": "validate", "selected": false}]},
    {"name": "success", "label": "Outcome", "type": "custom", "query": "true,false", "multi": true, "includeAll": true, "allValue": ".*", "current": {"text": ["All"], "value": ["$__all"]}, "options": [{"text": "All", "value": "$__all", "selected": true}, {"text": "true", "value": "true", "selected": false}, {"text": "false", "value": "false", "selected": false}]}
  ]},
  "panels": [
    {"id": 1, "type": "text", "title": "Scope and interpretation", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 6}, "options": {"mode": "markdown", "content": "**Scope:** Environment, action, operation and Outcome filter RPC metrics, sampled traces and completion logs. DB context is service/environment-wide, never action/operation/outcome scoped. Environment is telemetry resource identity. Selecting Outcome=true intentionally leaves failure-only panels empty.\n\n**Interpretation:** Expected client/validation failures are not internal SLO failures. Internal/unclassified failures are an investigation signal, not an agreed SLO. Histograms have no error_type dimension; use the failure breakdown instead of an error filter. No traffic gives undefined quantiles, never synthetic zero latency. Sparse tails are noisy; range counts are extrapolated estimates.\n\n**Correlation:** Native trace IDs open Tempo; sampling/retention can leave traces empty. Completion logs retain unassigned organization/auth/parser failures and original trace IDs. Explore links preserve filters and time.\n\n**Deployments:** Shared tikkit-deployment annotations span environments; publish manually or externally and include environment and version in annotation text. No deployment automation or alerts are implied."}},
    {"id": 2, "type": "timeseries", "title": "RPC requests / second · action / operation", "description": "Selected outcomes, summed across instances. Missing series are not fabricated as zero.", "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (action, operation) (rate(tikkit_rpc_requests_total{service_name=\"$service\",deployment_environment=~\"${environment:regex}\",action=~\"${action:regex}\",operation=~\"${operation:regex}\",success=~\"${success:regex}\"}[$__rate_interval]))", "legendFormat": "{{action}} · {{operation}}", "range": true, "exemplar": true}], "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 10, "spanNulls": false}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 3, "type": "timeseries", "title": "RPC failures / second · action / error type", "description": "Includes expected client/validation failures, not an internal SLO. Both success=false and selected Outcome apply; true-only selection returns no failures.", "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (action, error_type) (rate(tikkit_rpc_requests_total{service_name=\"$service\",deployment_environment=~\"${environment:regex}\",action=~\"${action:regex}\",operation=~\"${operation:regex}\",success=~\"${success:regex}\",success=\"false\"}[$__rate_interval]))", "legendFormat": "{{action}} · {{error_type}}", "range": true, "exemplar": true}], "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"drawStyle": "line", "spanNulls": false}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 4, "type": "timeseries", "title": "RPC latency · p50 / p95 / p99", "description": "Bucket rates aggregated across selected actions, operations, outcomes and instances before quantiles. No observations means undefined latency. Histograms cannot filter error_type.", "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [
      {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(tikkit_rpc_duration_milliseconds_bucket{service_name=\"$service\",deployment_environment=~\"${environment:regex}\",action=~\"${action:regex}\",operation=~\"${operation:regex}\",success=~\"${success:regex}\"}[$__rate_interval])))", "legendFormat": "p50", "range": true, "exemplar": true},
      {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(tikkit_rpc_duration_milliseconds_bucket{service_name=\"$service\",deployment_environment=~\"${environment:regex}\",action=~\"${action:regex}\",operation=~\"${operation:regex}\",success=~\"${success:regex}\"}[$__rate_interval])))", "legendFormat": "p95", "range": true, "exemplar": true},
      {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(tikkit_rpc_duration_milliseconds_bucket{service_name=\"$service\",deployment_environment=~\"${environment:regex}\",action=~\"${action:regex}\",operation=~\"${operation:regex}\",success=~\"${success:regex}\"}[$__rate_interval])))", "legendFormat": "p99", "range": true, "exemplar": true}
    ], "fieldConfig": {"defaults": {"unit": "ms", "min": 0, "custom": {"drawStyle": "line", "spanNulls": false}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 5, "type": "table", "title": "Estimated range requests · action / operation / outcome", "description": "Extrapolated Prometheus increases over the full selected range, not audited totals. Fractional counts are expected; no synthetic zero rows.", "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (action, operation, success) (increase(tikkit_rpc_requests_total{service_name=\"$service\",deployment_environment=~\"${environment:regex}\",action=~\"${action:regex}\",operation=~\"${operation:regex}\",success=~\"${success:regex}\"}[$__range]))", "format": "table", "instant": true, "range": false, "exemplar": false}], "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true}, "indexByName": {"action": 0, "operation": 1, "success": 2, "Value": 3}, "renameByName": {"action": "Action", "operation": "Operation", "success": "Outcome", "Value": "Requests (estimated)"}}}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 1}, "overrides": []}, "options": {"showHeader": true, "cellHeight": "sm", "sortBy": [{"displayName": "Requests (estimated)", "desc": true}]}},
    {"id": 6, "type": "table", "title": "Slowest actions · top 10 p95", "description": "Instant ranking at range end using the scrape-aware rate interval, not full-range p95. Buckets aggregate selected operations/outcomes and instances per action. Sparse samples are noisy; undefined quantiles are not zero.", "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "topk(10, histogram_quantile(0.95, sum by (le, action) (rate(tikkit_rpc_duration_milliseconds_bucket{service_name=\"$service\",deployment_environment=~\"${environment:regex}\",action=~\"${action:regex}\",operation=~\"${operation:regex}\",success=~\"${success:regex}\"}[$__rate_interval]))))", "format": "table", "instant": true, "range": false, "exemplar": false}], "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true}, "indexByName": {"action": 0, "Value": 1}, "renameByName": {"action": "Action", "Value": "p95"}}}], "fieldConfig": {"defaults": {"unit": "ms", "decimals": 1}, "overrides": []}, "options": {"showHeader": true, "cellHeight": "sm", "sortBy": [{"displayName": "p95", "desc": true}]}},
    {"id": 7, "type": "timeseries", "title": "Internal / unclassified failures / second · action", "description": "Failed outcomes classified internal_error, unknown_error or error. Investigation signal in req/s, not a percentage or agreed internal SLO. Selected Outcome still applies; success=true returns no series. Inspect logs to distinguish faults from classification gaps.", "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (action) (rate(tikkit_rpc_requests_total{service_name=\"$service\",deployment_environment=~\"${environment:regex}\",action=~\"${action:regex}\",operation=~\"${operation:regex}\",success=~\"${success:regex}\",success=\"false\",error_type=~\"internal_error|unknown_error|error\"}[$__rate_interval]))", "legendFormat": "{{action}}", "range": true, "exemplar": true}], "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"drawStyle": "line", "spanNulls": false}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 8, "type": "timeseries", "title": "DB p95 · query / queue · service context", "description": "Service/environment only: action, operation and Outcome do not filter repository metrics. Independent query/queue distributions must not be added. No queries means undefined latency.", "gridPos": {"x": 0, "y": 30, "w": 24, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [
      {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(tikkit_repo_query_query_time_milliseconds_bucket{service_name=\"$service\",deployment_environment=~\"${environment:regex}\"}[$__rate_interval])))", "legendFormat": "Query p95", "range": true, "exemplar": true},
      {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(tikkit_repo_query_queue_time_milliseconds_bucket{service_name=\"$service\",deployment_environment=~\"${environment:regex}\"}[$__rate_interval])))", "legendFormat": "Queue p95", "range": true, "exemplar": true}
    ], "fieldConfig": {"defaults": {"unit": "ms", "min": 0, "custom": {"drawStyle": "line", "spanNulls": false}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 9, "type": "table", "title": "Sampled RPC traces · selected filters", "description": "Native Tempo TraceQL search, up to 20 traces in the selected time range. Action, operation and string-encoded success attributes (exporter 1.10) match selected regexes. Trace IDs retain native View trace links. Sampling/retention may leave no matching traces.", "gridPos": {"x": 0, "y": 38, "w": 24, "h": 10}, "datasource": {"type": "tempo", "uid": "tempo"}, "targets": [{"refId": "A", "datasource": {"type": "tempo", "uid": "tempo"}, "queryType": "traceql", "query": "{ resource.service.name = \"$service\" && resource.deployment.environment =~ \"${environment:regex}\" && span.tikkit.rpc.action =~ \"${action:regex}\" && span.tikkit.rpc.operation =~ \"${operation:regex}\" && span.tikkit.rpc.success =~ \"${success:regex}\" }", "tableType": "traces", "limit": 20, "filters": []}], "fieldConfig": {"defaults": {}, "overrides": []}, "options": {"showHeader": true, "cellHeight": "sm"}},
    {"id": 10, "type": "logs", "title": "Related RPC completion logs · selected filters", "description": "Newest 100 matching completion lines, parsed from message.event/action/operation/success. No nonempty or regex organization constraint: unassigned authentication/parser failures remain eligible. Original trace/span IDs remain available for native correlation; these are completion events, not audited business totals.", "gridPos": {"x": 0, "y": 48, "w": 24, "h": 10}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "{service_name=\"$service\",deployment_environment=~\"${environment:regex}\"} |= \"rpc_completed\" | json event=\"message.event\", organization_id=\"message.organization_id\", action=\"message.action\", operation=\"message.operation\", success=\"message.success\", error_type=\"message.error_type\", duration_ms=\"message.duration_ms\" | __error__=\"\" | event=\"rpc_completed\" | action=~\"${action:regex}\" | operation=~\"${operation:regex}\" | success=~\"${success:regex}\"", "queryType": "range", "editorMode": "code", "maxLines": 100}], "fieldConfig": {"defaults": {"noValue": "No completion events"}, "overrides": []}, "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"}}
  ]
}
