{
  "uid": "tikkit-api",
  "title": "Tikkit API",
  "description": "RPC traffic, outcomes and latency with repository and BEAM context, sampled traces and related service logs.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": ["tikkit", "application"],
  "timezone": "browser",
  "refresh": "1m",
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "annotations": {"list": []},
  "links": [
    {
      "title": "Explore logs",
      "type": "link",
      "targetBlank": true,
      "url": "/explore?schemaVersion=1&panes=%7B%22A%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D%5C%22$service%5C%22%2Cdeployment_environment%3D~%5C%22${environment:regex}%5C%22%7D%22%2C%22queryType%22%3A%22range%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"
    },
    {
      "title": "Explore RPC traces",
      "type": "link",
      "targetBlank": true,
      "url": "/explore?schemaVersion=1&panes=%7B%22A%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22query%22%3A%22%7B%20resource.service.name%20%3D%20%5C%22$service%5C%22%20%26%26%20resource.deployment.environment%20%3D~%20%5C%22${environment:regex}%5C%22%20%26%26%20span.tikkit.rpc.action%20%3D~%20%5C%22${action:regex}%5C%22%20%7D%22%2C%22queryType%22%3A%22traceql%22%2C%22tableType%22%3A%22traces%22%2C%22limit%22%3A20%2C%22filters%22%3A%5B%5D%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"
    }
  ],
  "templating": {
    "list": [
      {"name": "service", "label": "Service", "type": "constant", "hide": 2, "query": "tikkit-api", "current": {"text": "tikkit-api", "value": "tikkit-api"}},
      {
        "name": "environment", "label": "Environment", "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(tikkit_rpc_requests_total{service_name=\"$service\"},deployment_environment)",
        "query": {"query": "label_values(tikkit_rpc_requests_total{service_name=\"$service\"},deployment_environment)", "refId": "EnvironmentVariableQuery"},
        "refresh": 2, "sort": 1, "multi": true, "includeAll": true, "allValue": ".*",
        "current": {"text": ["All"], "value": ["$__all"]}, "options": []
      },
      {
        "name": "action", "label": "RPC action", "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(tikkit_rpc_requests_total{service_name=\"$service\",deployment_environment=~\"${environment:regex}\"},action)",
        "query": {"query": "label_values(tikkit_rpc_requests_total{service_name=\"$service\",deployment_environment=~\"${environment:regex}\"},action)", "refId": "ActionVariableQuery"},
        "refresh": 2, "sort": 1, "multi": true, "includeAll": true, "allValue": ".*",
        "current": {"text": ["All"], "value": ["$__all"]}, "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "text", "title": "Reading this dashboard",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 4},
      "options": {"mode": "markdown", "content": "**Scope:** RPC action filters apply to RPC metrics and traces only; DB, BEAM and logs stay service/environment-wide. Environment comes from telemetry resource identity, not the Docker context or Mix build.\n\n**Low traffic:** No traffic ≠ zero latency; missing/undefined quantiles are not filled with zero. Rates use Grafana's scrape-aware interval; range counts are extrapolated estimates. Failure outcomes include client/validation errors, not just internal faults.\n\n**Correlation:** Exemplars and traces are sampled, so not every request has a trace. Trace IDs in the table open Tempo. Logs are related service logs, not an exact RPC-action match. Explore links retain the dashboard time range. **Skip alerts until an owner/contact and actionable thresholds are agreed.**"}
    },
    {
      "id": 2, "type": "timeseries", "title": "RPC requests / second by action",
      "description": "Request rate across operations, outcomes and instances for selected actions. An absent series can mean missing telemetry, not zero traffic.",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (action) (rate(tikkit_rpc_requests_total{service_name=\"$service\",deployment_environment=~\"${environment:regex}\",action=~\"${action:regex}\"}[$__rate_interval]))", "legendFormat": "{{action}}", "range": true, "exemplar": true}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 10, "spanNulls": false}, "links": [{"title": "Explore logs", "targetBlank": true, "url": "/explore?schemaVersion=1&panes=%7B%22A%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D%5C%22$service%5C%22%2Cdeployment_environment%3D~%5C%22${environment:regex}%5C%22%7D%22%2C%22queryType%22%3A%22range%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"}]}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 3, "type": "timeseries", "title": "RPC failure outcomes / second",
      "description": "success=\"false\" grouped by error_type. Includes client/validation failures; this is not an internal-server-error rate. Inspect error types and logs before interpreting reliability. Missing series are not filled with zero.",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (error_type) (rate(tikkit_rpc_requests_total{service_name=\"$service\",deployment_environment=~\"${environment:regex}\",action=~\"${action:regex}\",success=\"false\"}[$__rate_interval]))", "legendFormat": "{{error_type}}", "range": true, "exemplar": true}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"drawStyle": "line", "spanNulls": false}, "links": [{"title": "Explore logs", "targetBlank": true, "url": "/explore?schemaVersion=1&panes=%7B%22A%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D%5C%22$service%5C%22%2Cdeployment_environment%3D~%5C%22${environment:regex}%5C%22%7D%22%2C%22queryType%22%3A%22range%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"}]}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 4, "type": "timeseries", "title": "RPC latency · p50 / p95 / p99",
      "description": "Milliseconds across selected actions and all outcomes/instances. Bucket rates are summed by le before quantiles. No observations produce undefined latency, not zero; sparse samples make tail estimates noisy.",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(tikkit_rpc_duration_milliseconds_bucket{service_name=\"$service\",deployment_environment=~\"${environment:regex}\",action=~\"${action:regex}\"}[$__rate_interval])))", "legendFormat": "p50", "range": true, "exemplar": true},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(tikkit_rpc_duration_milliseconds_bucket{service_name=\"$service\",deployment_environment=~\"${environment:regex}\",action=~\"${action:regex}\"}[$__rate_interval])))", "legendFormat": "p95", "range": true, "exemplar": true},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(tikkit_rpc_duration_milliseconds_bucket{service_name=\"$service\",deployment_environment=~\"${environment:regex}\",action=~\"${action:regex}\"}[$__rate_interval])))", "legendFormat": "p99", "range": true, "exemplar": true}
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0, "custom": {"drawStyle": "line", "spanNulls": false}, "links": [{"title": "Explore logs", "targetBlank": true, "url": "/explore?schemaVersion=1&panes=%7B%22A%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D%5C%22$service%5C%22%2Cdeployment_environment%3D~%5C%22${environment:regex}%5C%22%7D%22%2C%22queryType%22%3A%22range%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"}]}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 5, "type": "table", "title": "RPC requests in selected range · action / outcome",
      "description": "Estimated increase over the full dashboard range, grouped by action and success (true/false). Prometheus extrapolation can yield fractional counts. No synthetic zero rows are added for unobserved outcomes.",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (action, success) (increase(tikkit_rpc_requests_total{service_name=\"$service\",deployment_environment=~\"${environment:regex}\",action=~\"${action:regex}\"}[$__range]))", "format": "table", "instant": true, "range": false}],
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true}, "indexByName": {"action": 0, "success": 1, "Value": 2}, "renameByName": {"action": "Action", "success": "Success", "Value": "Requests (estimated)"}}}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 1, "links": [{"title": "Explore logs", "targetBlank": true, "url": "/explore?schemaVersion=1&panes=%7B%22A%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D%5C%22$service%5C%22%2Cdeployment_environment%3D~%5C%22${environment:regex}%5C%22%7D%22%2C%22queryType%22%3A%22range%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"}]}, "overrides": []},
      "options": {"showHeader": true, "cellHeight": "sm", "sortBy": [{"displayName": "Requests (estimated)", "desc": true}]}
    },
    {
      "id": 6, "type": "timeseries", "title": "DB p95 · query / queue time",
      "description": "Service/environment-wide repository histogram quantiles in milliseconds, not filtered by RPC action. Query and queue p95 are independent distributions; do not add them. No queries means undefined latency, not zero.",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(tikkit_repo_query_query_time_milliseconds_bucket{service_name=\"$service\",deployment_environment=~\"${environment:regex}\"}[$__rate_interval])))", "legendFormat": "Query p95", "range": true, "exemplar": true},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(tikkit_repo_query_queue_time_milliseconds_bucket{service_name=\"$service\",deployment_environment=~\"${environment:regex}\"}[$__rate_interval])))", "legendFormat": "Queue p95", "range": true, "exemplar": true}
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0, "custom": {"drawStyle": "line", "spanNulls": false}, "links": [{"title": "Explore logs", "targetBlank": true, "url": "/explore?schemaVersion=1&panes=%7B%22A%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D%5C%22$service%5C%22%2Cdeployment_environment%3D~%5C%22${environment:regex}%5C%22%7D%22%2C%22queryType%22%3A%22range%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"}]}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 7, "type": "timeseries", "title": "BEAM memory · total bytes",
      "description": "BEAM allocated memory summed across service instances in selected environments. Not container RSS and not filtered by RPC action.",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(vm_memory_total_bytes{service_name=\"$service\",deployment_environment=~\"${environment:regex}\"})", "legendFormat": "BEAM memory (all instances)", "range": true}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 10, "spanNulls": false}, "links": [{"title": "Explore logs", "targetBlank": true, "url": "/explore?schemaVersion=1&panes=%7B%22A%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D%5C%22$service%5C%22%2Cdeployment_environment%3D~%5C%22${environment:regex}%5C%22%7D%22%2C%22queryType%22%3A%22range%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"}]}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "single", "sort": "none"}}
    },
    {
      "id": 8, "type": "timeseries", "title": "BEAM processes · count",
      "description": "Process count summed across service instances in selected environments. The upstream metric's _ratio suffix is a translation artifact: values are counts, not percentages. RPC action does not filter this panel.",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(vm_system_counts_process_count_ratio{service_name=\"$service\",deployment_environment=~\"${environment:regex}\"})", "legendFormat": "Processes (all instances)", "range": true}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0, "custom": {"drawStyle": "line", "spanNulls": false}, "links": [{"title": "Explore logs", "targetBlank": true, "url": "/explore?schemaVersion=1&panes=%7B%22A%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D%5C%22$service%5C%22%2Cdeployment_environment%3D~%5C%22${environment:regex}%5C%22%7D%22%2C%22queryType%22%3A%22range%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"}]}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "single", "sort": "none"}}
    },
    {
      "id": 9, "type": "timeseries", "title": "BEAM run queues · counts",
      "description": "CPU, I/O and total run queue lengths summed across service instances in selected environments. _ratio is an upstream naming artifact; values are counts. Total includes components, so series are not stacked. Not filtered by RPC action.",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(vm_total_run_queue_lengths_cpu_ratio{service_name=\"$service\",deployment_environment=~\"${environment:regex}\"})", "legendFormat": "CPU", "range": true},
        {"refId": "B", "expr": "sum(vm_total_run_queue_lengths_io_ratio{service_name=\"$service\",deployment_environment=~\"${environment:regex}\"})", "legendFormat": "I/O", "range": true},
        {"refId": "C", "expr": "sum(vm_total_run_queue_lengths_total_ratio{service_name=\"$service\",deployment_environment=~\"${environment:regex}\"})", "legendFormat": "Total", "range": true}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0, "custom": {"drawStyle": "line", "spanNulls": false}, "links": [{"title": "Explore logs", "targetBlank": true, "url": "/explore?schemaVersion=1&panes=%7B%22A%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D%5C%22$service%5C%22%2Cdeployment_environment%3D~%5C%22${environment:regex}%5C%22%7D%22%2C%22queryType%22%3A%22range%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"}]}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 10, "type": "table", "title": "Sampled RPC traces",
      "description": "Native Tempo TraceQL search, up to 20 matching traces in the dashboard time range. Trace ID fields carry Tempo's built-in View trace links. Sampling/retention can leave this table empty even when RPC metrics show traffic.",
      "gridPos": {"x": 0, "y": 36, "w": 24, "h": 10},
      "datasource": {"type": "tempo", "uid": "tempo"},
      "targets": [{"refId": "A", "datasource": {"type": "tempo", "uid": "tempo"}, "queryType": "traceql", "query": "{ resource.service.name = \"$service\" && resource.deployment.environment =~ \"${environment:regex}\" && span.tikkit.rpc.action =~ \"${action:regex}\" }", "tableType": "traces", "limit": 20, "filters": []}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true, "cellHeight": "sm"}
    },
    {
      "id": 11, "type": "logs", "title": "Related service logs",
      "description": "Service/environment logs in the selected time range, newest first. Logs lack RPC action labels: the action selector intentionally does not filter this panel. Use trace correlation where available; these are not guaranteed to belong to the selected RPC action.",
      "gridPos": {"x": 0, "y": 46, "w": 24, "h": 10},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "{service_name=\"$service\",deployment_environment=~\"${environment:regex}\"}", "queryType": "range", "editorMode": "code", "maxLines": 100}],
      "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"}
    }
  ]
}
