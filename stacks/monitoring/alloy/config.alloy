// The single Alloy instance is both the internal OTLP gateway and the Docker
// stdout log collector. It intentionally has no published host ports: only
// services joined to the external `observability` overlay can reach it.

prometheus.remote_write "local" {
  endpoint {
    url            = "http://prometheus:9090/api/v1/write"
    send_exemplars = true
  }
}

loki.write "local" {
  external_labels = {
    cluster = "homelab",
  }

  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Convert incoming OTLP metrics into Prometheus metrics, then push them to the
// Prometheus remote-write receiver enabled in docker-stack.yml.
otelcol.exporter.prometheus "metrics" {
  resource_to_telemetry_conversion = true
  forward_to                      = [prometheus.remote_write.local.receiver]
}

// This route accepts OTLP logs from any compatible producer. Container stdout
// collection below remains the pragmatic fallback for applications that do not
// yet emit OTLP logs.
otelcol.exporter.loki "otlp_logs" {
  forward_to = [loki.write.local.receiver]
}

// Tempo's OTLP gRPC receiver is internal and deliberately has no TLS because
// it is reachable only over the private observability overlay network.
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }

  retry_on_failure {
    max_elapsed_time = "5m"
  }

  sending_queue {
    enabled      = true
    queue_size   = 5000
    num_consumers = 2
  }
}

// Bound collector memory before telemetry is batched. A full backend must
// cause drops/retries, never unbounded memory or application backpressure.
otelcol.processor.memory_limiter "default" {
  check_interval = "1s"
  limit          = "256MiB"
  spike_limit    = "64MiB"

  output {
    metrics = [otelcol.processor.transform.identity.input]
    logs    = [otelcol.processor.transform.identity.input]
    traces  = [otelcol.processor.transform.identity.input]
  }
}

// Newer OTel producers use deployment.environment.name. Retain a legacy alias
// so existing dashboards and producers can share one environment label. Never
// overwrite an explicit legacy value or manufacture an environment when absent.
otelcol.processor.transform "identity" {
  error_mode = "ignore"

  metric_statements {
    context = "resource"
    statements = [
      `set(attributes["deployment.environment"], attributes["deployment.environment.name"]) where attributes["deployment.environment"] == nil and attributes["deployment.environment.name"] != nil`,
    ]
  }

  trace_statements {
    context = "resource"
    statements = [
      `set(attributes["deployment.environment"], attributes["deployment.environment.name"]) where attributes["deployment.environment"] == nil and attributes["deployment.environment.name"] != nil`,
    ]
  }

  log_statements {
    context = "resource"
    statements = [
      `set(attributes["deployment.environment"], attributes["deployment.environment.name"]) where attributes["deployment.environment"] == nil and attributes["deployment.environment.name"] != nil`,
      // The Loki exporter uses this built-in hint to promote bounded resource
      // identity, matching Docker stdout labels. Respect producer overrides.
      `set(attributes["loki.resource.labels"], "service.name,service.namespace,deployment.environment") where attributes["loki.resource.labels"] == nil`,
    ]
  }

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  timeout          = "5s"
  send_batch_size  = 1024
  send_batch_max_size = 2048

  output {
    metrics = [otelcol.exporter.prometheus.metrics.input]
    logs    = [otelcol.exporter.loki.otlp_logs.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// OpenTelemetry Protocol: both standard gRPC and HTTP receivers are available
// for compatible telemetry producers.
otelcol.receiver.otlp "gateway" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.memory_limiter.default.input]
    logs    = [otelcol.processor.memory_limiter.default.input]
    traces  = [otelcol.processor.memory_limiter.default.input]
  }
}

// Container CPU/cgroup memory: embedded cAdvisor, not an app scrape endpoint
// or a separate privileged service. CPU/memory only need the Docker socket,
// read-only /sys and Docker's data directory (see docker-stack.yml).
prometheus.exporter.cadvisor "containers" {
  docker_only               = true
  disable_root_cgroup_stats = true
  enabled_metrics           = ["cpu", "memory"]
  store_container_labels    = false
  allowlisted_container_labels = [
    "service.name",
    "deployment.environment",
    "deployment.environment.name",
    "com.docker.swarm.service.name",
  ]
}

prometheus.scrape "containers" {
  targets         = prometheus.exporter.cadvisor.containers.targets
  job_name        = "integrations/cadvisor"
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.relabel.containers.receiver]
}

prometheus.relabel "containers" {
  forward_to = [prometheus.remote_write.local.receiver]

  // Keep only the resource signals used for capacity investigation.
  rule {
    source_labels = ["__name__"]
    regex = "container_(cpu_usage_seconds_total|cpu_cfs_periods_total|cpu_cfs_throttled_periods_total|cpu_cfs_throttled_seconds_total|spec_cpu_quota|spec_cpu_period|memory_working_set_bytes|memory_usage_bytes|spec_memory_limit_bytes|last_seen)"
    action = "keep"
  }
  rule {
    source_labels = ["name"]
    regex         = ".+"
    action        = "keep"
  }
  rule {
    target_label = "instance"
    replacement  = coalesce(sys.env("ALLOY_NODE_NAME"), constants.hostname)
  }
  rule {
    source_labels = ["name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["id"]
    target_label  = "container_id"
  }
  rule {
    source_labels = ["container"]
    target_label  = "service_name"
  }
  rule {
    source_labels = ["container_label_com_docker_swarm_service_name"]
    regex         = "(.+)"
    target_label  = "service_name"
  }
  rule {
    source_labels = ["container_label_service_name"]
    regex         = "(.+)"
    target_label  = "service_name"
  }
  // Docker labels are explicit deployment metadata; do not inspect arbitrary
  // container env vars or guess the environment from a name/Mix build mode.
  rule {
    source_labels = ["container_label_deployment_environment"]
    regex         = "(.+)"
    target_label  = "deployment_environment"
  }
  rule {
    source_labels = ["deployment_environment", "container_label_deployment_environment_name"]
    separator     = ";"
    regex         = ";(.+)"
    target_label  = "deployment_environment"
  }
  rule {
    regex  = "id|name|image|container_label_.*"
    action = "labeldrop"
  }
}

// Ship JSON logs written to Docker stdout. Do not use a second Alloy replica
// for this source: every replica would read the same Docker socket and duplicate
// log entries. Docker labels become low-cardinality Loki labels.
discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.local.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_stack_namespace"]
    target_label  = "stack"
  }

  // Stable fallback identity for ordinary containers and Swarm services.
  // Structured application metadata below takes precedence over Docker names.
  rule {
    source_labels = ["container"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["service"]
    regex         = "(.+)"
    target_label  = "service_name"
  }
}

loki.source.docker "local" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_logs.output
  forward_to = [loki.process.docker.receiver]
}

// Preserve raw log lines (including non-JSON output). Only bounded identity
// fields become labels; trace/span IDs and deployment versions are metadata,
// not indexed Loki labels. This is also compatible with LoggerJSON's fields.
loki.process "docker" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = {
      service_name           = "service_name || metadata.service_name",
      service_namespace      = "service_namespace || metadata.service_namespace",
      deployment_environment = "deployment_environment || metadata.deployment_environment",
      service_version        = "service_version || metadata.service_version",
      trace_id               = "trace_id || trace || metadata.trace_id",
      span_id                = "span_id || span || metadata.span_id",
    }
  }

  stage.labels {
    values = {
      service_name           = "",
      service_namespace      = "",
      deployment_environment = "",
    }
  }

  stage.structured_metadata {
    values = {
      trace_id        = "",
      span_id         = "",
      service_version = "",
    }
  }
}
